    given-names: Art
    affiliation: Banrox Inc.
    email: opensource@banrox.com
repository-code: https://github.com/BanroxArt/kyt-gate
license: MIT
version: 0.1.0
date-released: 2026-11-16
keywords:
  - stablecoin
  - kyt
  - sanctions-screening
  - ofac
  - travel-rule
  - genius-act
  - aml
  - policy-as-code
